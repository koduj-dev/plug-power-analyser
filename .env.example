# Copy to .env at the repo root (used by `npm start` via --env-file-if-exists)
# or export these as real environment variables, e.g. in the systemd/launchd
# unit files under packaging/, to override defaults.

# HTTP server
PPA_PORT=4400
PPA_HOST=0.0.0.0

# SQLite database file path (default: backend/data/plug-power-analyser.sqlite)
PPA_DB_PATH=

# IANA timezone used for day/week/month boundaries (default: host system timezone)
PPA_TZ=Europe/Prague

# Raw telemetry retention, in days (default: 7)
PPA_RETENTION_DAYS=7

# Directory containing the built frontend (default: ../frontend/dist relative to backend)
PPA_FRONTEND_DIST=

# pino log level: trace|debug|info|warn|error|fatal (default: info)
PPA_LOG_LEVEL=info
