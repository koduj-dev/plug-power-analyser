#!/bin/sh
# Runs after install/upgrade (as root, before privilege drop). Deliberately
# does not create $SYNOPKG_PKGVAR here -- DSM provisions it with the right
# ownership for the "run-as: package" user declared in
# conf/privilege/authorize.conf; start-stop-status creates it lazily on
# first start, running as that same user, so ownership stays consistent.
exit 0
