#!/bin/sh
# Runs before install/upgrade. Fails fast with a clear message if the
# Node.js v22 package (a hard runtime dependency) isn't installed yet.
set -u

for candidate in \
  /var/packages/Node.js_v22/target/usr/local/bin/node \
  /var/packages/Node.js_v20/target/usr/local/bin/node \
  /usr/local/bin/node \
  /usr/bin/node
do
  if [ -x "$candidate" ]; then
    exit 0
  fi
done

if command -v node >/dev/null 2>&1; then
  exit 0
fi

echo "Plug Power Analyser requires the 'Node.js v22' package. Install it from Package Center first, then retry." >&2
exit 1
